rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile doc ──────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Audit logs (one doc per day per user) ─────────────────
    // Doc ID format:  {uid}_{dateKey}   e.g. "abc123_2026-07-23"
    // Splitting by day keeps each doc well under the 1 MB limit.
    match /userAuditLogs/{docId} {

      // CREATE — doc doesn't exist yet, check incoming data
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // READ / UPDATE / DELETE — doc exists, check stored uid field
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.uid;

      // LIST (collection query / orderBy documentId range scan) —
      // resource is null during a list; allow any authenticated user
      // to list since the doc-ID prefix already scopes results to
      // their own uid.
      allow list: if request.auth != null;
    }

    // ── Legacy audit_log collection ───────────────────────────
    match /audit_log/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }

    // ── Shared pass list ──────────────────────────────────────
    match /admin/passlist {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "digvijaysingh705123@gmail.com";
    }

  }
}
