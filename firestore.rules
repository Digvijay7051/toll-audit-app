rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile doc ──────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Audit logs (one doc per day per user) ─────────────────
    // Doc ID format:  {uid}_{dateKey}   e.g. "abc123_2026-07-23"
    // Splitting by day keeps each doc well under the 1 MB limit.
    match /userAuditLogs/{docId} {

      // CREATE — doc doesn't exist yet, check incoming data owns the uid field
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // READ / UPDATE / DELETE — doc exists, owner check via stored uid field
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.uid;

      // LIST — resource is null so per-doc ownership cannot be checked here.
      // Fix: require the query to filter on uid == the caller's own uid, which
      // every client query already does (the ID-prefix range scan is equivalent).
      // This prevents any authenticated user from running an unscoped collection
      // scan that returns other users' documents.
      allow list: if request.auth != null
                  && request.query.filters.size() > 0
                  && request.query.filters.hasAny([
                       ['uid', '==', request.auth.uid]
                     ]);
    }

    // ── Learned rules per user (Correct & Learn feature) ─────
    // agent.js writes/reads fbDb.collection('agentRules').doc(uid)
    // Previously unmatched → Firestore denied by default; writes
    // silently failed and only localStorage was ever used.
    match /agentRules/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Legacy audit_log collection ───────────────────────────
    match /audit_log/{docId} {
      allow create: if request.auth != null
                   && request.auth.uid == request.resource.data.uid;
      allow read:   if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }

    // ── Shared pass list ──────────────────────────────────────
    match /admin/passlist {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "digvijaysingh705123@gmail.com";
    }

  }
}
